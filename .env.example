# ---- Web app (Vercel → Project → Settings → Environment Variables) ----
# Public values only. They are embedded in the browser bundle at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Browser inference is the default; leave unset/empty. Only set for an actual trusted Python service.
VITE_MODEL_API_URL=
# Hosting build target (set manually in Vercel Production and Preview).
NITRO_PRESET=vercel

# ---- Model service (Hugging Face Space → Settings → Variables and secrets) ----
# Never put these in the web app or in GitHub.
# SUPABASE_URL=https://your-project-ref.supabase.co              (variable)
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx                     (variable)
# SUPABASE_SERVICE_ROLE_KEY=<service role / secret key>           (SECRET)
# ALLOWED_ORIGINS=https://your-app.vercel.app                     (variable, comma separated)
# MODEL_REPO_ID=your-hf-username/cardiofusion-artifacts           (variable, private model repo)
# HF_TOKEN=<read token for the private model repo>                (SECRET)
# ECG_LABEL_0= / ECG_LABEL_1=     only once confirmed from training code
# ECHO_CLASSES_VERIFIED=false     set true only once class order is confirmed
